# Which LLM backend to serve. "mock" runs offline with no cloud account.
# Switch to "azure" once you have a fine-tuned deployment in Azure AI Foundry.
LLM_PROVIDER=mock

# CORS: comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173

# ---- Azure AI Foundry (only needed when LLM_PROVIDER=azure) ----
# The target URI of your deployed fine-tuned model, e.g.
#   https://<resource>.openai.azure.com
AZURE_FOUNDRY_ENDPOINT=
# The deployment name you gave the fine-tuned model.
AZURE_FOUNDRY_DEPLOYMENT=
# API key for the resource.
AZURE_FOUNDRY_API_KEY=
# Azure OpenAI data-plane API version.
AZURE_FOUNDRY_API_VERSION=2024-08-01-preview

# Generation defaults.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_SYSTEM_PROMPT=You are FineTune Forge, a helpful assistant fine-tuned for this application.
