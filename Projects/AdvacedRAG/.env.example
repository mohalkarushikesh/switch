# ---------- LLM ----------
# Not required if you have run `ant auth login` (the SDK picks up the profile).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_FAST_MODEL=claude-haiku-4-5
LLM_EFFORT=high
LLM_REFUSAL_FALLBACKS=true

# ---------- Vector store (Qdrant) ----------
# Leave QDRANT_URL empty to use the embedded local store at QDRANT_PATH (no Docker needed).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=k8s_ops

# ---------- Embeddings / reranking ----------
# auto | fastembed | keyword   (keyword = pure-Python BM25, no model download)
RETRIEVAL_BACKEND=auto
DENSE_MODEL=BAAI/bge-small-en-v1.5
# If huggingface.co is blocked but storage.googleapis.com is not, use one of the
# six dense models fastembed also mirrors on GCS - fastembed tries HF first and
# falls back to the mirror automatically:
#   BAAI/bge-base-en-v1.5                   dim 768,  204 MB
#   BAAI/bge-small-en                       dim 384,   78 MB
#   sentence-transformers/all-MiniLM-L6-v2  dim 384,   83 MB
#   BAAI/bge-base-en                        dim 768,  420 MB
#   BAAI/bge-small-zh-v1.5                  dim 512,   90 MB
#   intfloat/multilingual-e5-large          dim 1024, 2.24 GB
# Every fastembed SPARSE model and reranker is HF-only; the sparse arm then falls
# back to the local BM25 implementation on its own and reranking stays lexical.
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Point at a pre-populated fastembed cache if huggingface.co is blocked here.
MODEL_CACHE_DIR=
# Token for authenticating model downloads. Note: it does NOT help if the block
# is at the network layer - see the Readme for how to tell the two apart.
HF_TOKEN=

# ---------- Text2SQL store ----------
# Leave empty to fall back to a local SQLite file at data/ops.db.
POSTGRES_DSN=
# POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/ops

# ---------- Cache ----------
# Leave empty to use an in-process cache instead of Redis.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.95

# ---------- Retrieval tuning ----------
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
HYBRID_DENSE_WEIGHT=0.7

# ---------- Pipeline feature flags ----------
ENABLE_HYDE=true
ENABLE_CRAG=true
ENABLE_SELF_RAG=true
ENABLE_TEXT2SQL=true
ENABLE_GUARDRAILS=true
ENABLE_CACHE=true

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
