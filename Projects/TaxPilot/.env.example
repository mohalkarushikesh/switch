# ---------- LLM ----------
# Backend the agents call through: anthropic (Claude) or gemini (Google).
LLM_PROVIDER=anthropic
# Not required if you have run `ant auth login` (the SDK picks up the profile).
ANTHROPIC_API_KEY=
# Only used when LLM_PROVIDER=gemini.
GOOGLE_API_KEY=
LLM_MODEL=claude-opus-4-8
# Cheaper model for the many small extraction/classification/grading calls.
LLM_FAST_MODEL=claude-haiku-4-5
LLM_EFFORT=high
LLM_REFUSAL_FALLBACKS=true

# ---------- Tax year ----------
# Financial-year start: 2024 == FY 2024-25 (AY 2025-26). Constants ship for this year only.
TAX_YEAR=2024

# ---------- Knowledge base (IRS rules) ----------
# Directory of IRS-publication excerpts indexed for the deduction researcher.
CORPUS_DIR=data/corpus
# Retrieval is pure-Python BM25 - no model download, works with huggingface.co blocked.
RETRIEVE_TOP_K=5

# ---------- Document intake ----------
DOCUMENTS_DIR=data/documents
# Confidence below this on an extracted field flags the return for human review.
EXTRACTION_CONFIDENCE_FLOOR=0.75

# ---------- Reviewer gate (human-in-the-loop) ----------
# A return is escalated to a human when any of these trip.
REVIEW_RISK_THRESHOLD=60
# Refund or balance-payable (absolute rupees) at or above which a human must sign off.
REVIEW_AMOUNT_THRESHOLD=100000

# ---------- Feature flags ----------
ENABLE_RAG=true
ENABLE_AUDIT=true
ENABLE_REVIEW=true
ENABLE_GUARDRAILS=true

# ---------- Feedback ----------
# Human corrections are appended here as JSONL to improve future runs.
FEEDBACK_DIR=feedback

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
