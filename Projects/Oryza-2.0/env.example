# Application Configuration
APP_NAME=Oryza
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# API Gateway
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://oryza_user:oryza_pass@localhost:5432/oryza_db
MONGODB_URL=mongodb://localhost:27017/oryza_logs
REDIS_URL=redis://localhost:6379/0
INFLUXDB_URL=http://localhost:8086
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Vector Database
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# API Keys - Financial Data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
NEWS_API_KEY=your_news_api_key
CURRENCY_LAYER_API_KEY=your_currency_layer_key

# ESG Data Providers
MSCI_API_KEY=your_msci_api_key
SUSTAINALYTICS_API_KEY=your_sustainalytics_api_key

# Open Banking
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ML Model Configuration
MODEL_STORAGE_PATH=/models
MLFLOW_TRACKING_URI=http://localhost:5000

# Agent Communication
AGENT_COMMUNICATION_PORT=9000
AGENT_REGISTRY_URL=http://localhost:8500

# Security
ENCRYPTION_KEY=your-encryption-key-32-chars-long!!
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Cloud Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=oryza-storage

# Feature Flags
ENABLE_MULTI_AGENT=true
ENABLE_ESG_FEATURES=true
ENABLE_WEALTH_CONCIERGE=true
ENABLE_PAPER_TRADING=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json 