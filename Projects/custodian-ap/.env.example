# --- LLM provider credentials (used by LiteLLM) ---
# Set the key for whichever provider CUSTODIAN_LLM_MODEL points at. If that key
# is missing, the risk agent falls back to heuristic scoring, so the pipeline
# still runs end-to-end without any API keys.
OPENAI_API_KEY=
GROQ_API_KEY=
# Hugging Face Inference token (hf_...). HF_TOKEN is also accepted.
HUGGINGFACE_API_KEY=
# Anthropic API key (sk-ant-...) for claude-* models.
ANTHROPIC_API_KEY=

# Model routed through LiteLLM. The prefix selects the provider AND which key
# above is used; a bare name means OpenAI. Examples:
#   gpt-4o-mini                                    (OpenAI)
#   groq/llama-3.1-8b-instant                      (Groq)
#   huggingface/meta-llama/Llama-3.1-8B-Instruct   (Hugging Face)
#   anthropic/claude-opus-4-8                      (Anthropic)
# With LiteLLM >= 1.60 an HF model may need an explicit inference provider:
#   huggingface/hf-inference/meta-llama/Llama-3.1-8B-Instruct
#   huggingface/together/meta-llama/Llama-3.3-70B-Instruct
CUSTODIAN_LLM_MODEL=gpt-4o-mini

# Hard kill-switch: force heuristic scoring and make no outbound LLM calls,
# even when a provider key is present. Useful on restricted networks and in CI.
CUSTODIAN_DISABLE_LLM=

# --- Approval routing thresholds ---
# Invoices at or below this risk score AND at or below the amount cap are auto-paid.
CUSTODIAN_AUTO_PAY_MAX_RISK=30
CUSTODIAN_AUTO_PAY_MAX_AMOUNT=5000
# Invoices at or above this risk score are rejected outright.
CUSTODIAN_REJECT_MIN_RISK=75

# --- Mock ledger ---
# Starting balance the auto-pay agent draws down from (in INR).
CUSTODIAN_LEDGER_BALANCE=1000000

# --- Governance ---
# Absolute per-invoice ceiling; anything above is blocked outright by policy.
CUSTODIAN_POLICY_MAX_AMOUNT=250000
# Comma-separated vendor names to deny (case-insensitive).
CUSTODIAN_BLOCKED_VENDORS=
# If set, every processed invoice is appended to this JSONL audit log.
# (The API always persists to SQLite as well; this is an optional extra sink.)
CUSTODIAN_AUDIT_LOG=

# --- Persistence ---
# SQLite database for processed invoices + audit trail (survives restarts).
# Use ":memory:" for an ephemeral, in-process database.
CUSTODIAN_DB_PATH=data/custodian.db

# --- PII redaction backend ---
# "regex" (default, no deps), "presidio" (needs presidio-analyzer + a spaCy
# model; falls back to regex if unavailable), or "auto".
CUSTODIAN_PII_BACKEND=regex

# --- API authentication ---
# Comma-separated "key:role" pairs (roles: submitter, reviewer, admin).
# Leave empty to disable auth (all endpoints open). Reads stay open by design;
# only submit/approve/reject are protected.
# Example: CUSTODIAN_API_KEYS=sk-sub:submitter,sk-rev:reviewer,sk-admin:admin
CUSTODIAN_API_KEYS=

# --- Notifications ---
# Fire on rejected invoices and on any invoice scored at/above this risk.
CUSTODIAN_NOTIFY_MIN_RISK=70
# Optional sinks (best-effort): POST to a webhook and/or append to a JSONL file.
CUSTODIAN_WEBHOOK_URL=
CUSTODIAN_NOTIFY_LOG=

# --- Model tracking (MLflow) ---
# If set, each risk-scoring decision is logged to MLflow. Use a local file store
# ("./mlruns"), a SQLite DB ("sqlite:///mlflow.db"), or a tracking-server URL
# ("http://localhost:5000"). Empty = disabled. Requires: pip install mlflow-skinny
CUSTODIAN_MLFLOW_URI=
CUSTODIAN_MLFLOW_EXPERIMENT=custodian-risk

# --- Full infra stack (docker-compose.infra.yml) ---
POSTGRES_USER=custodian
POSTGRES_PASSWORD=custodian
POSTGRES_DB=custodian
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin
LANGFUSE_NEXTAUTH_SECRET=changeme-langfuse-secret
LANGFUSE_SALT=changeme-langfuse-salt
# Optional: forward LiteLLM traces to Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
